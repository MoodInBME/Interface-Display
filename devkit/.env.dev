# Environment untuk pengembangan LOKAL di laptop (bukan Raspberry Pi).
# Salin file ini menjadi .env di root repo:  cp .env.dev .env

MOODIN_MQTT_HOST=localhost
MOODIN_MQTT_PORT=1883
MOODIN_MQTT_USERNAME=
MOODIN_MQTT_PASSWORD=
# Kosongkan CA -> koneksi TANPA TLS (hanya untuk dev lokal).
MOODIN_MQTT_TLS_CA=
MOODIN_MQTT_CLIENT_ID=interface-display-dev

MOODIN_DB_PATH=data/moodin_ui.db
MOODIN_LOG_LEVEL=DEBUG

# windowed = jalan dalam jendela biasa (bukan fullscreen kiosk).
MOODIN_DISPLAY_MODE=windowed
