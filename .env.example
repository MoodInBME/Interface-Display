# Salin ke .env dan sesuaikan. JANGAN commit .env.
MOODIN_MQTT_HOST=localhost
MOODIN_MQTT_PORT=8883
MOODIN_MQTT_USERNAME=moodin_ui
MOODIN_MQTT_PASSWORD=change_me
MOODIN_MQTT_TLS_CA=/opt/moodin/certs/ca.crt
MOODIN_MQTT_CLIENT_ID=interface-display

# Path database tren lokal
MOODIN_DB_PATH=data/moodin_ui.db

# Level log: DEBUG | INFO | WARNING | ERROR
MOODIN_LOG_LEVEL=INFO

# Mode tampilan: kiosk | windowed (dev)
MOODIN_DISPLAY_MODE=kiosk
